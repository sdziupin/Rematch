{
  "expo": {
    "name": "REMATCH",
    "slug": "rematch",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "rematch",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sdziupin.rematch",
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "5K9D77KS36",
      "infoPlist": {
        "NSHealthShareUsageDescription": "REMATCH reads your body weight to estimate the calories of each workout it saves.",
        "NSHealthUpdateUsageDescription": "REMATCH saves your finished workouts to Apple Health, so they count in Fitness alongside everything else."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.rematch.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "REMATCH",
      "shortName": "REMATCH",
      "description": "Race your past self. Benchmark workouts with live checkpoint telemetry.",
      "themeColor": "#09090B",
      "backgroundColor": "#09090B",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#09090B",
          "imageWidth": 200
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.sdziupin.rematch.widgets",
          "groupIdentifier": "group.com.sdziupin.rematch",
          "widgets": [
            {
              "name": "RematchWeek",
              "displayName": "This week",
              "description": "Your weekly goal and your last race.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ]
    ],
    "description": "A benchmark fitness app where your past performance becomes a live opponent."
  }
}
